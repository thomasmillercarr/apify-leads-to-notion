# Copy to .env and fill in. Never commit .env.

# Notion: create an internal integration at https://www.notion.so/my-integrations
# and share your leads database with it.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Apify: Console -> Settings -> Integrations
APIFY_TOKEN=
# Optional, defaults to microworlds~leads-finder
APIFY_ACTOR_ID=microworlds~leads-finder
